{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talo-docs",
  "compatibility_date": "2026-08-14",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true,
  },
  "main": "./workers/app.ts",
}
